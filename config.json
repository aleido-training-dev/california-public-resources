      "Map": {
        "PlayerFiles": ["index.html", "assets"],
        "Resources": [
          {
            "Source": "https://bitbucket.org/california-public-resources/california-downloads/raw/HEAD/Volvo-Cars-XML-Interpreter.zip",
            "Name": "Volvo-Cars-XML-Interpreter",
            "Alias": "XML-Interpreter"
          },
          {
            "Source": "https://bitbucket.org/california-public-resources/california-downloads/raw/HEAD/Volvo-Cars-courseJSON.json",
            "Name": "Volvo-Cars-courseJSON",
            "Alias": "courseJSON.json"
          }
        ],
        "InsertInto": ["**/*.xml", "**/*.json"],
        "Structure": [
          {
            "test": "^[0-9a-f]{32}-[0-9]+$",
            "target": "data/XML"
          },
          {
            "type": ".xml",
            "target": "data/XML"
          },
          {
            "type": ".zip",
            "process": "unzip",
            "target": "data"
          }
        ]
      }
    },
    {
      "ID": "AB Volvo",
      "Name": "AB Volvo - Kentucky",
      "Source": "https://bitbucket.org/california-public-resources/california-downloads/raw/HEAD/AB-Volvo.zip",
