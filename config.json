            "Name": "AB-Volvo-languages",
            "Alias": "languages.json"
          }
        ],
        "LanguagePattern": "_[a-z]{2}-[A-Z]{2}",
        "InsertInto": ["**/*.xml", "**/*.json"],
        "Structure": [
          {
            "type": ".xml",
            "target": "data/XML"
          },
          {
            "type": "xml",
            "target": "data"
